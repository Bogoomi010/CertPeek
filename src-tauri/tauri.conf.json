{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CertPeek",
  "version": "0.2.0",
  "identifier": "io.github.bogoomi010.cert-viewer",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CertPeek",
        "width": 480,
        "height": 480,
        "minWidth": 480,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
